# Copy to .env.server; leave the existing Windows .env unchanged.
# Set a new long password, enclosed in single quotes.
POSTGRES_PASSWORD=''
# Local testing only. Later set the Linux server LAN IP.
APP_BIND_IP=127.0.0.1
# Address typed into the browser (server LAN IP or an internal host name).
# The HTTPS certificate is issued for exactly this name.
APP_HOST=localhost
# Für Anmeldesessions. Einmal erzeugen und danach nie mehr ändern (sonst werden
# alle bestehenden Anmeldungen ungültig): python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=''
